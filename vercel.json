{
  "version": 2,
  "crons": [
    {
      "path": "/api/datacrazy/daily-report-send",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/datacrazy/*.js": {
      "maxDuration": 60
    },
    "api/kommo/*.js": {
      "maxDuration": 60
    },
    "api/meta/*.js": {
      "maxDuration": 60
    },
    "api/calcom/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
