{
  "version": 2,
  "functions": {
    "api/datacrazy/*.js": {
      "maxDuration": 60
    },
    "api/meta/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
